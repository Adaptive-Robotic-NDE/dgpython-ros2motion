import dgpython_rosmotion as rosm

global ros
ros = rosm.motion('ros', 'tool0', 'world')


def runscan(t1, t2, n, m):

    x = np.linspace(t1.transform.translation.x, t2.transform.translation.x, n)
    y = np.linspace(t1.transform.translation.y, t2.transform.translation.y, m)

    for i in range(n):
        for j in range(m):
            print("Moving to (x = %.6f, y = %.6f)" % (x[i], y[j]))
            t2.transform.translation.x = x[i]
            t2.transform.translation.y = y[j]
            ros.Move(t2)           

    
        
def demoscan(t1, t2, t3, m, n):
	
    p1 = np.array([t1.transform.translation.x, t1.transform.translation.y, t1.transform.translation.z])
    p2 = np.array([t2.transform.translation.x, t2.transform.translation.y, t2.transform.translation.z])
    p3 = np.array([t3.transform.translation.x, t3.transform.translation.y, t3.transform.translation.z])

    ux, uy, uz = u = p2-p1 
    vx, vy, vz = v = p3-p1

    w = np.array([uy*vz-uz*vy, uz*vx-ux*vz, ux*vy-uy*vx])
    #Normalize the cross product to get the magnitude of 1 
    w = w/np.linalg.norm(w) 
    v = np.cross(w, u)
    v = v/np.linalg.norm(v)
    
    d = -np.sum(v*p1)
    #minumum distance 
    r = np.abs(np.sum(v * p3) + d)/np.sqrt(np.sum(v*v))
    
    maguprime = np.linalg.norm(u) 
    magvprime = r 
    
    uprime = np.linspace(0 , maguprime, m) 
    vprime = np.linspace(0, magvprime, n)
    u = u / maguprime 
    uu, vv = np.meshgrid(vprime, uprime) 
    

    # Creating array of zeros 
    ww = np.zeros(uu.shape) 
    
    rot = np.dstack([u, v, w])[0,:,:]
    
    uu, vv, ww = np.einsum( 'ji, mni -> jmn', rot, np.dstack([uu, vv, ww]))
    uu += p1[0] 
    vv += p1[1]
    ww += p1[2]
    
    for i in range(m):
        for j in range (n):
            print("Moving to (x = %.6f, y = %.6f, z = %.6f)" % (uu[i,j], vv[i, j], ww[i,j]))
            t3.transform.translation.x = uu[i,j]
            t3.transform.translation.y = vv[i,j]
            t3.transform.translation.z = ww[i,j]
            ros.Move(t3)           

